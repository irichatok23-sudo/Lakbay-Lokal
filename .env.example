# ==============================================================================
# Lakbay Lokal: Community Tourism Information System - Configuration
# ==============================================================================
# Copy this file to .env or configure your system environment variables.
# All settings have safe built-in defaults if left undefined.

# Backend Server Configuration
LAKBAY_PORT=8080
LAKBAY_HOST=127.0.0.1

# MySQL Database Configuration
# Default connection string connects to local MySQL service on port 3306.
# If MySQL is not running, the system will log a helpful notice and safely 
# fallback to integrated demo data so the desktop app remains functional.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lakbay_lokal_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JDBC URL (Constructed automatically from above parameters if not specified)
# DB_URL=jdbc:mysql://localhost:3306/lakbay_lokal_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Manila&characterEncoding=utf8

# Desktop Application Configuration
ELECTRON_ENABLE_DEVTOOLS=false
