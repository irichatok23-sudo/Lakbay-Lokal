            ]
        },
        {
            "type": "java",
            "name": "Run Lakbay Lokal (Swing Desktop App)",
            "request": "launch",
            "mainClass": "lakbaylokal.Main",
            "projectName": "lakbay-lokal-cbtis",
            "cwd": "${workspaceFolder}",
            "classPaths": [
                "${workspaceFolder}/bin",
                "${workspaceFolder}/target/classes",
                "${workspaceFolder}/lib/mysql-connector-j.jar"
            ]
        }
    ]
}

