<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lakbay Lokal | Community-Based Tourism Information System - Biliran</title>
    <meta name="description" content="A centralized digital platform promoting local destinations, empowering community tourism stakeholders, and managing bookings in Biliran Province, Philippines.">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Main Style -->
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <!-- ======================================================================= -->
    <!-- DESKTOP WINDOW TITLEBAR (For Electron / Desktop Application)             -->
    <!-- ======================================================================= -->
    <div class="desktop-titlebar" id="desktop-window-bar">
        <div class="desktop-titlebar-brand">
            <img src="assets/icon.png" alt="Lakbay Lokal" class="desktop-titlebar-icon" onerror="this.style.display='none'">
            <span>Lakbay Lokal: Community Tourism Information System - Biliran</span>
        </div>
        <div class="desktop-titlebar-controls" id="desktop-titlebar-controls">
            <button class="titlebar-btn" id="btn-win-minimize" onclick="minimizeDesktopWindow()" title="Minimize"><i class="fa-solid fa-minus"></i></button>
            <button class="titlebar-btn" id="btn-win-maximize" onclick="maximizeDesktopWindow()" title="Maximize / Restore"><i class="fa-regular fa-square"></i></button>
            <button class="titlebar-btn close" id="btn-win-close" onclick="closeDesktopWindow()" title="Close"><i class="fa-solid fa-xmark"></i></button>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- VIEW 0: DEDICATED LOGIN / SIGN IN PAGE (FIRST SCREEN FOR UNAUTHENTICATED) -->
    <!-- ======================================================================= -->
    <div id="login-portal-view" class="portal-view active">
        <div class="glass-portal-card">
            <!-- Left Section: Branding & Community Mission -->
            <div class="glass-left-panel">
                <div class="glass-left-brand">
                    <div class="glass-brand-icon">
                        <i class="fa-solid fa-compass-drafting"></i>
                    </div>
                    <div>
                        <div class="glass-brand-name">LAKBAY LOKAL</div>
                        <div class="glass-brand-tagline">Biliran Community Tourism System</div>
                    </div>
                </div>

                <div class="glass-left-body">
                    <h3 class="glass-welcome-title">Mabuhay &amp; Welcome!</h3>
                    <p class="glass-welcome-desc">
                        A centralized platform empowering local tour guides, boat operators, habal-habal drivers, homestay cooks, and artisans across Biliran Province, Philippines.
                    </p>
                </div>

                <div class="glass-left-footer">
                    <span><i class="fa-solid fa-location-dot"></i> Province of Biliran • Region VIII</span>
                </div>
            </div>

            <!-- Right Section: Clean Modern Sign In Form -->
            <div class="glass-right-panel">
                <div class="glass-form-header">
                    <h2 class="glass-form-heading">Sign In to Lakbay Lokal</h2>
                    <p class="glass-form-subtext">Access your community tourism workspace</p>
                </div>

                <!-- Error Feedback Banner -->
                <div class="glass-error-banner" id="glass-login-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span id="glass-login-error-text">Invalid username or password.</span>
                </div>

                <form id="form-glass-login" onsubmit="return handleGlassLoginSubmit(event)">
                    <div class="glass-field-group">
                        <label class="glass-field-label" for="glass-login-username">Username or Email Address</label>
                        <div class="glass-input-wrapper">
                            <i class="fa-solid fa-user glass-input-icon"></i>
                            <input type="text" id="glass-login-username" class="glass-input" required autocomplete="username" placeholder="Enter your username or email">
                        </div>
                    </div>

                    <div class="glass-field-group">
                        <label class="glass-field-label" for="glass-login-password">Password</label>
                        <div class="glass-input-wrapper">
                            <i class="fa-solid fa-lock glass-input-icon"></i>
                            <input type="password" id="glass-login-password" class="glass-input" required autocomplete="current-password" placeholder="Enter your password">
                            <button type="button" class="glass-btn-toggle-pwd" id="btn-toggle-pwd" onclick="togglePasswordVisibility()" title="Show/Hide Password" aria-label="Toggle password visibility">
                                <i class="fa-solid fa-eye" id="toggle-pwd-icon"></i>
                            </button>
                        </div>
                    </div>

                    <div class="glass-form-options">
                        <label class="glass-checkbox-label">
                            <input type="checkbox" id="glass-remember-me" checked>
                            <span>Remember Me</span>
                        </label>
                        <button type="button" class="glass-forgot-link" onclick="openForgotPasswordModal()">
                            Forgot Password?
                        </button>
                    </div>

                    <button type="submit" class="glass-btn-submit" id="btn-glass-submit">
                        <i class="fa-solid fa-right-to-bracket" id="btn-glass-submit-icon"></i>
                        <span id="btn-glass-submit-text">Sign In</span>
                    </button>
                </form>

                <!-- Registration Prompt -->
                <div class="glass-register-section">
                    <div class="glass-register-divider">
                        <span>New to Lakbay Lokal?</span>
                    </div>
                    <button type="button" class="glass-btn-register-tourist" onclick="openRegisterModal('tourist')">
                        <i class="fa-solid fa-umbrella-beach"></i> Register as Tourist
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- VIEW 1: PUBLIC TOURISM HOMEPAGE & PORTAL (AUTHENTICATED TOURISTS)        -->
    <!-- ======================================================================= -->
    <div id="public-portal-view" class="portal-view">
        <div class="public-portal-wrapper">
            
            <!-- Public Navbar -->
            <nav class="public-navbar">
                <div class="nav-brand">
                    <div class="brand-logo">
                        <i class="fa-solid fa-compass-drafting brand-icon"></i>
                    </div>
                    <div class="brand-text">
                        <h1 class="brand-title">LAKBAY LOKAL</h1>
                        <span class="brand-subtitle"><i class="fa-solid fa-location-dot"></i> Biliran Province Tourism Network</span>
                    </div>
                </div>

                <ul class="public-nav-links">
                    <li><a href="#public-hero" class="public-nav-link"><i class="fa-solid fa-house"></i> Home</a></li>
                    <li><a href="#public-destinations" class="public-nav-link"><i class="fa-solid fa-mountain-sun"></i> Destinations</a></li>
                    <li><a href="#public-experiences" class="public-nav-link"><i class="fa-solid fa-suitcase-rolling"></i> Experiences</a></li>
                    <li><a href="#public-stakeholders" class="public-nav-link"><i class="fa-solid fa-people-roof"></i> Local Livelihoods</a></li>
                    <li><a href="#public-about" class="public-nav-link"><i class="fa-solid fa-circle-info"></i> About Biliran</a></li>
                </ul>

                <div class="public-nav-actions">
                    <div id="public-auth-actions" style="display: flex; align-items: center; gap: 0.75rem;">
                        <button class="btn btn-primary" onclick="showManagementDashboard('packages')">
                            <i class="fa-solid fa-suitcase-rolling"></i> Plan Tour
                        </button>
                        <button class="btn btn-outline" onclick="showManagementDashboard('bookings')">
                            <i class="fa-solid fa-calendar-check"></i> My Bookings
                        </button>
                        <div class="user-pill-tag" style="display: flex; align-items: center; gap: 0.4rem; font-weight: 600; font-size: 0.85rem; color: var(--primary-800); background: var(--primary-50); padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid var(--primary-200);">
                            <i class="fa-solid fa-user-circle"></i>
                            <span id="public-user-name-label">Tourist</span>
                        </div>
                        <button class="btn btn-secondary btn-sm" id="btn-public-logout" onclick="handleLogout()" title="Sign Out of Lakbay Lokal">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i> <span>Sign Out</span>
                        </button>
                    </div>
                </div>
            </nav>

            <!-- Authenticated Tourist Welcome Hub -->
            <div id="tourist-hub-banner" class="tourist-hub-banner" style="background: linear-gradient(135deg, var(--primary-900) 0%, var(--primary-700) 60%, var(--cyan-700) 100%); padding: 1.5rem 2rem; color: #ffffff; border-bottom: 1px solid rgba(255,255,255,0.16);">
                <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
                    <div>
                        <div style="display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.28); color: var(--primary-100); padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; margin-bottom: 0.4rem;">
                            <i class="fa-solid fa-compass"></i> Authenticated Tourist Workspace
                        </div>
                        <h2 style="font-size: 1.4rem; font-weight: 800; color: #ffffff; margin: 0 0 0.25rem 0;" id="tourist-hub-greeting-text">Mabuhay, Ana Sophia Cortez!</h2>
                        <p style="margin: 0; color: var(--primary-100); font-size: 0.85rem;">Explore Biliran's natural marvels, reserve accredited guides and boats, and track your trip reservations.</p>
                    </div>
                    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                        <button class="btn btn-primary" onclick="showManagementDashboard('packages')"><i class="fa-solid fa-calendar-plus"></i> Custom Itinerary</button>
                        <button class="btn btn-outline" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.4); color: #ffffff;" onclick="showManagementDashboard('bookings')"><i class="fa-solid fa-list-check"></i> My Reservations</button>
                    </div>
                </div>
            </div>

            <!-- Hero Section -->
            <section class="public-hero-section" id="public-hero">
                <div class="public-hero-content">
                    <div class="hero-pill-badge">
                        <i class="fa-solid fa-shield-heart"></i> Sustainable Community Tourism • Biliran, Philippines
                    </div>
                    <h2 class="public-hero-title">Discover the Untouched Wonder of Biliran</h2>
                    <p class="public-hero-subtitle">
                        Experience world-class marine sanctuaries, cascading jungle waterfalls, therapeutic volcanic springs, and genuine community hospitality powered directly by accredited local guides, boat operators, cooks, and artisans.
                    </p>

                    <!-- Interactive Destination Search & Filter in Hero -->
                    <div class="hero-search-wrapper">
                        <div class="hero-search-input-box">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="public-hero-search-input" placeholder="Search waterfalls, island sandbars, springs..." oninput="handlePublicSearch()">
                        </div>
                        <div class="hero-search-divider"></div>
                        <select id="public-hero-cat-filter" class="hero-search-select" onchange="handlePublicSearch()">
                            <option value="ALL">All Categories</option>
                            <option value="WATERFALL">Waterfalls</option>
                            <option value="ISLAND_BEACH">Islands & Beaches</option>
                            <option value="HOT_SPRING">Hot Springs</option>
                            <option value="CULTURAL_HERITAGE">Cultural Heritage</option>
                        </select>
                        <div class="hero-search-divider"></div>
                        <select id="public-hero-muni-filter" class="hero-search-select" onchange="handlePublicSearch()">
                            <option value="ALL">All Municipalities</option>
                            <option value="Naval">Naval</option>
                            <option value="Almeria">Almeria</option>
                            <option value="Maripipi">Maripipi</option>
                            <option value="Caibiran">Caibiran</option>
                            <option value="Kawayan">Kawayan</option>
                            <option value="Culaba">Culaba</option>
                            <option value="Cabucgayan">Cabucgayan</option>
                            <option value="Biliran">Biliran</option>
                        </select>
                        <button class="hero-btn-search" onclick="scrollToSection('public-destinations')">
                            <i class="fa-solid fa-compass"></i> Explore
                        </button>
                    </div>

                    <!-- Fast Statistics Bar -->
                    <div class="hero-stats-row">
                        <div class="hero-stat-card">
                            <span class="hero-stat-num">8</span>
                            <span class="hero-stat-label">Municipalities</span>
                        </div>
                        <div class="hero-stat-card">
                            <span class="hero-stat-num" id="stat-hero-dest-count">8</span>
                            <span class="hero-stat-label">Eco-Destinations</span>
                        </div>
                        <div class="hero-stat-card">
                            <span class="hero-stat-num" id="stat-hero-stakeholder-count">5</span>
                            <span class="hero-stat-label">Verified Stakeholders</span>
                        </div>
                        <div class="hero-stat-card">
                            <span class="hero-stat-num">100%</span>
                            <span class="hero-stat-label">Direct Community Benefit</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Featured Destinations Section -->
            <section class="public-section" id="public-destinations">
                <div class="section-header-center">
                    <span class="section-tag"><i class="fa-solid fa-mountain-sun"></i> Explore Biliran</span>
                    <h2 class="section-title">Biliran Destinations & Natural Attractions</h2>
                    <p class="section-subtitle">
                        Immerse yourself in clean turquoise marine sanctuaries, towering rain waterfalls, and therapeutic mineral springs.
                    </p>
                </div>

                <!-- Category Filter Pills -->
                <div class="category-filter-pills" id="public-category-pills">
                    <button class="cat-pill active" data-cat="ALL" onclick="filterPublicCategory('ALL')"><i class="fa-solid fa-border-all"></i> All Attractions</button>
                    <button class="cat-pill" data-cat="WATERFALL" onclick="filterPublicCategory('WATERFALL')"><i class="fa-solid fa-water"></i> Waterfalls</button>
                    <button class="cat-pill" data-cat="ISLAND_BEACH" onclick="filterPublicCategory('ISLAND_BEACH')"><i class="fa-solid fa-umbrella-beach"></i> Islands & Beaches</button>
                    <button class="cat-pill" data-cat="HOT_SPRING" onclick="filterPublicCategory('HOT_SPRING')"><i class="fa-solid fa-temperature-arrow-up"></i> Hot Springs</button>
                    <button class="cat-pill" data-cat="CULTURAL_HERITAGE" onclick="filterPublicCategory('CULTURAL_HERITAGE')"><i class="fa-solid fa-landmark"></i> Cultural Heritage</button>
                </div>

                <!-- Public Destination Cards Grid -->
                <div class="public-cards-grid" id="public-destinations-grid">
                    <!-- Populated dynamically by JavaScript -->
                </div>
            </section>

            <!-- Experiences & Curated Packages Section -->
            <section class="public-section bg-light" id="public-experiences">
                <div class="section-header-center">
                    <span class="section-tag"><i class="fa-solid fa-wand-magic-sparkles"></i> Curated Circuits</span>
                    <h2 class="section-title">Community Experiences & Travel Circuits</h2>
                    <p class="section-subtitle">
                        Choose pre-designed community circuits or connect directly with certified guides and transport operators.
                    </p>
                </div>

                <div class="public-cards-grid" id="public-packages-grid">
                    <!-- Populated dynamically by JavaScript -->
                </div>

                <!-- Custom Builder Spotlight Banner -->
                <div class="card mt-4" style="background: linear-gradient(135deg, var(--primary-900) 0%, var(--primary-700) 60%, var(--cyan-700) 100%); color: #ffffff; border: none; border-radius: 20px; padding: 2.5rem; text-align: center;">
                    <h3 style="font-size: 1.85rem; font-weight: 800; color: #ffffff; margin-bottom: 0.75rem;">
                        <i class="fa-solid fa-sliders"></i> Want to Build Your Custom Travel Itinerary?
                    </h3>
                    <p style="font-size: 1.05rem; color: var(--primary-100); max-width: 680px; margin: 0 auto 1.5rem; line-height: 1.6;">
                        Select individual tour guides, habal-habal motorcycle drivers, boat charters, and traditional native feasts with instant automated budget calculation.
                    </p>
                    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
                        <button class="btn btn-primary" style="background: #ffffff; color: var(--primary-900); border-color: #ffffff;" onclick="showManagementDashboard('packages'); togglePackageSubTab('custom');">
                            <i class="fa-solid fa-compass"></i> Open Custom Itinerary Builder
                        </button>
                    </div>
                </div>
            </section>

            <!-- Community Stakeholders & Livelihood Discovery Section -->
            <section class="public-section" id="public-stakeholders">
                <div class="section-header-center">
                    <span class="section-tag"><i class="fa-solid fa-people-roof"></i> Community Livelihoods</span>
                    <h2 class="section-title">Empowering Local Tourism Workers</h2>
                    <p class="section-subtitle">
                        Lakbay Lokal connects travelers directly with certified local guides, drivers, boat operators, cooks, and artisans across Biliran.
                    </p>
                </div>

                <div class="community-grid">
                    <div class="community-worker-card">
                        <div class="worker-avatar"><i class="fa-solid fa-person-hiking"></i></div>
                        <h4 class="worker-name">Pedro Penduko</h4>
                        <span class="worker-role">Sambawan Marine & Trek Guide</span>
                        <p class="worker-desc">6 years DOT-certified experience leading snorkelers through Sambawan marine sanctuary and summit viewpoints.</p>
                        <span class="badge badge-success"><i class="fa-solid fa-certificate"></i> DOT Accredited</span>
                    </div>

                    <div class="community-worker-card">
                        <div class="worker-avatar"><i class="fa-solid fa-motorcycle"></i></div>
                        <h4 class="worker-name">Juan Dela Cruz</h4>
                        <span class="worker-role">Habal-Habal & Van Driver</span>
                        <p class="worker-desc">Navigating mountain routes, Almeria waterfalls, and scenic highways with safety gear and local knowledge.</p>
                        <span class="badge badge-success"><i class="fa-solid fa-certificate"></i> LGU Registered</span>
                    </div>

                    <div class="community-worker-card">
                        <div class="worker-avatar"><i class="fa-solid fa-ship"></i></div>
                        <h4 class="worker-name">Capitan Danilo Flores</h4>
                        <span class="worker-role">Motorized Boat Operator</span>
                        <p class="worker-desc">Maripipi Seafarers Cooperative pumpboat operator with 10 years maritime crossing safety record.</p>
                        <span class="badge badge-success"><i class="fa-solid fa-certificate"></i> MARINA Certified</span>
                    </div>

                    <div class="community-worker-card">
                        <div class="worker-avatar"><i class="fa-solid fa-utensils"></i></div>
                        <h4 class="worker-name">Nanay Luz Ocampo</h4>
                        <span class="worker-role">Local Cook & Beach Feasts</span>
                        <p class="worker-desc">Serving traditional native inasal, fresh catch boodle fights, and authentic Biliran sticky rice delicacies.</p>
                        <span class="badge badge-success"><i class="fa-solid fa-certificate"></i> Barangay Verified</span>
                    </div>

                    <div class="community-worker-card">
                        <div class="worker-avatar"><i class="fa-solid fa-palette"></i></div>
                        <h4 class="worker-name">Rosa Mangahas</h4>
                        <span class="worker-role">Clay Pottery Artisan</span>
                        <p class="worker-desc">Generational master potter teaching visitors the art of traditional Maripipi red clay molding.</p>
                        <span class="badge badge-success"><i class="fa-solid fa-certificate"></i> DTI Registered</span>
                    </div>
                </div>
            </section>

            <!-- About Biliran & Sustainable Tourism Section -->
            <section class="public-section bg-light" id="public-about">
                <div class="about-dual-grid">
                    <div>
                        <span class="section-tag"><i class="fa-solid fa-shield-heart"></i> About Lakbay Lokal</span>
                        <h2 class="section-title">Community-Driven Tourism in Biliran Province</h2>
                        <p class="section-subtitle" style="margin-bottom: 1.5rem;">
                            Biliran is one of the smallest and most ecologically diverse island provinces in the Philippines. From the volcanic peaks of Mt. Biliran to the shifting sandbars of Higatangan and the crystal waters of Sambawan, our mission is sustainable, community-first preservation.
                        </p>

                        <div class="about-features-list">
                            <div class="about-feature-item">
                                <div class="about-feature-icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                                <div>
                                    <h4 class="about-feature-title">Direct Livelihood Retention</h4>
                                    <p class="about-feature-desc">100% of guide fees, boat charters, and culinary packages go directly to local barangay families without middleman deductions.</p>
                                </div>
                            </div>

                            <div class="about-feature-item">
                                <div class="about-feature-icon"><i class="fa-solid fa-seedling"></i></div>
                                <div>
                                    <h4 class="about-feature-title">Ecological Carrying Capacity</h4>
                                    <p class="about-feature-desc">Real-time footfall logging by Barangay Officials ensures marine sanctuaries and waterfalls are never overcrowded.</p>
                                </div>
                            </div>

                            <div class="about-feature-item">
                                <div class="about-feature-icon"><i class="fa-solid fa-shield-halved"></i></div>
                                <div>
                                    <h4 class="about-feature-title">Verified & Accredited Safety</h4>
                                    <p class="about-feature-desc">All service providers undergo Barangay and DOT validation, providing tourists with safe and reliable travel experiences.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="about-visual-card">
                        <img src="assets/tinago_falls.jpg" alt="Tinago Falls Eco-Park - Caibiran, Biliran" loading="lazy">
                        <div class="about-visual-badge">
                            <h4 style="font-size: 1.1rem; font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;"><i class="fa-solid fa-leaf" style="color: var(--primary-300);"></i> Tinago Falls Eco-Park</h4>
                            <p style="font-size: 0.82rem; color: var(--primary-100); margin: 0;">Preserved and managed by Barangay Cabibihan, Caibiran, Biliran Province</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Public Footer -->
            <footer class="public-footer" id="public-footer">
                <div class="footer-top-grid">
                    <div>
                        <div class="footer-brand-title">
                            <i class="fa-solid fa-compass-drafting" style="color: var(--primary-300);"></i> LAKBAY LOKAL
                        </div>
                        <p class="footer-brand-desc">
                            A Community-Based Tourism Information and Management System empowering local stakeholders across all 8 municipalities of Biliran Province, Region VIII (Eastern Visayas), Philippines.
                        </p>
                        <div style="display: flex; gap: 0.75rem;">
                            <span class="badge badge-success"><i class="fa-solid fa-island-tropical"></i> Eastern Visayas</span>
                        </div>
                    </div>

                    <div>
                        <h4 class="footer-col-title">Explore</h4>
                        <ul class="footer-links-list">
                            <li><a href="#public-destinations" class="footer-link">Destinations</a></li>
                            <li><a href="#public-experiences" class="footer-link">Curated Packages</a></li>
                            <li><a href="#public-stakeholders" class="footer-link">Local Guides</a></li>
                            <li><a href="#public-about" class="footer-link">About Biliran</a></li>
                        </ul>
                    </div>

                    <div>
                        <h4 class="footer-col-title">Participating LGUs</h4>
                        <ul class="footer-links-list">
                            <li><span class="footer-link">Naval (Capital)</span></li>
                            <li><span class="footer-link">Almeria Waterfalls</span></li>
                            <li><span class="footer-link">Maripipi & Sambawan</span></li>
                            <li><span class="footer-link">Caibiran & Tinago</span></li>
                            <li><span class="footer-link">Kawayan & Higatangan</span></li>
                        </ul>
                    </div>

                    <div>
                        <h4 class="footer-col-title">Tourism Support</h4>
                        <p class="footer-brand-desc" style="margin-bottom: 0.75rem;">
                            Provincial Tourism Office: <br>
                            <strong style="color: #ffffff;">tourism@biliran.gov.ph</strong>
                        </p>
                        <p class="footer-brand-desc">
                            Emergency Hotline: <br>
                            <strong style="color: var(--primary-300);">+63 917 000 0002</strong>
                        </p>
                    </div>
                </div>

                <div class="footer-bottom-bar">
                    <span>&copy; 2026 Lakbay Lokal Tourism Network • All Rights Reserved.</span>
                    <span>Designed for Sustainable Tourism • Biliran Province, Philippines</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- VIEW 2: MANAGEMENT PORTAL & 6-ROLE DASHBOARD (16 SYSTEM MODULES)        -->
    <!-- ======================================================================= -->
    <div id="management-portal-view" class="portal-view">
        <div id="app-container" class="app-layout">
            
