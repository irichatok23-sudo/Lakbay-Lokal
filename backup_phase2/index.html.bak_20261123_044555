                    </div>
                    <div class="form-group">
                        <label class="form-label">Email Address <span class="text-danger">*</span></label>
                        <input type="email" id="user-form-email" class="form-input" required placeholder="official@biliran.gov.ph">
                    </div>
                    <div class="form-group grid-2-col">
                        <div>
                            <label class="form-label">Assigned Role <span class="text-danger">*</span></label>
                            <select id="user-form-role" class="form-select" required onchange="handleUserFormRoleChange()">
                                <option value="6">Tourist</option>
                                <option value="5">Local Stakeholder</option>
                                <option value="4">Barangay Official</option>
                                <option value="3">Municipal Tourism Officer (LGU)</option>
                                <option value="2">Tourism Office Officer</option>
                                <option value="1">System Administrator</option>
                            </select>
                        </div>
                        <div id="user-form-muni-group">
                            <label class="form-label" id="user-form-muni-label">Municipality <span class="text-danger">*</span></label>
                            <select id="user-form-municipality" class="form-select" onchange="handleUserFormMuniChange()">
                                <option value="">Select Municipality</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group" id="user-form-brgy-group">
                        <label class="form-label" id="user-form-brgy-label">Jurisdiction Barangay <span class="text-danger">*</span></label>
                        <select id="user-form-barangay" class="form-select">
                            <option value="">Select Barangay</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" id="btn-create-user-submit">
                        <i class="fa-solid fa-user-plus"></i> Create User Account
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- CREATE / EDIT CURATED PACKAGE MODAL                                     -->
    <!-- ======================================================================= -->
    <div class="modal-backdrop" id="modal-add-package">
        <div class="modal-dialog" style="max-width: 650px;">
            <div class="modal-header">
                <h3 class="modal-title" id="modal-add-package-title"><i class="fa-solid fa-suitcase-rolling"></i> Create Curated Tourism Package</h3>
                <button class="btn-close" onclick="closeModal('modal-add-package')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="form-add-package" onsubmit="handleSavePackageSubmit(event)">
                    <input type="hidden" id="pkg-form-id">
                    <div class="form-group">
                        <label class="form-label">Package Name</label>
                        <input type="text" id="pkg-form-name" class="form-input" required placeholder="e.g. Sambawan &amp; Maripipi Heritage Circuit">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <textarea id="pkg-form-desc" class="form-textarea" rows="2" required placeholder="Describe the curated travel itinerary..."></textarea>
                    </div>
                    <div class="form-group grid-2-col">
                        <div>
                            <label class="form-label">Price Per Person (PHP)</label>
                            <input type="number" id="pkg-form-price" class="form-input" min="0" step="0.01" value="1200.00" required>
                        </div>
                        <div>
                            <label class="form-label">Duration (Days)</label>
                            <input type="number" id="pkg-form-duration" class="form-input" min="1" max="14" value="1" required>
                        </div>
                    </div>
                    <div class="form-group grid-2-col">
                        <div>
                            <label class="form-label">Minimum Pax</label>
                            <input type="number" id="pkg-form-minpax" class="form-input" min="1" max="50" value="2" required>
                        </div>
                        <div>
                            <label class="form-label">Maximum Pax</label>
                            <input type="number" id="pkg-form-maxpax" class="form-input" min="1" max="50" value="10" required>
                        </div>
                    </div>
                    <div class="form-group grid-2-col">
                        <div>
                            <label class="form-label">Inclusions</label>
                            <input type="text" id="pkg-form-inclusions" class="form-input" value="Accredited local guide, transport, entrance fees">
                        </div>
                        <div>
                            <label class="form-label">Exclusions</label>
                            <input type="text" id="pkg-form-exclusions" class="form-input" value="Personal expenses, optional tipping">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Included Destinations</label>
                        <div id="pkg-form-destinations-list" style="max-height: 110px; overflow-y: auto; border: 1px solid var(--slate-200); border-radius: 6px; padding: 0.5rem;"></div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Assigned Stakeholder Services</label>
                        <div id="pkg-form-services-list" style="max-height: 110px; overflow-y: auto; border: 1px solid var(--slate-200); border-radius: 6px; padding: 0.5rem;"></div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Save Curated Package</button>
                </form>
            </div>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- STAKEHOLDER PROFILE & REGISTRATION MODAL                                -->
    <!-- ======================================================================= -->
    <div class="modal-backdrop" id="modal-stakeholder-profile">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 class="modal-title" id="modal-stakeholder-profile-title"><i class="fa-solid fa-id-badge"></i> Stakeholder Profile</h3>
                <button class="btn-close" onclick="closeModal('modal-stakeholder-profile')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="form-stakeholder-profile" onsubmit="handleSaveStakeholderProfileSubmit(event)">
                    <input type="hidden" id="stk-form-id">
                    <div id="stk-new-account-fields" style="display: none;">
                        <div class="form-group">
                            <label class="form-label">Owner Full Name</label>
                            <input type="text" id="stk-form-fullname" class="form-input" placeholder="e.g. Roberto Dela Cruz">
                        </div>
                        <div class="form-group grid-2-col">
                            <div>
                                <label class="form-label">Account Username</label>
                                <input type="text" id="stk-form-username" class="form-input" placeholder="e.g. guide_roberto">
                            </div>
                            <div>
                                <label class="form-label">Initial Password</label>
                                <input type="password" id="stk-form-password" class="form-input" value="password123">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email Address</label>
                            <input type="email" id="stk-form-email" class="form-input" placeholder="stakeholder@lakbaylokal.ph">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Business / Provider Name</label>
                        <input type="text" id="stk-form-business" class="form-input" required placeholder="e.g. Pedro's Eco-Guiding Services">
                    </div>
                    <div class="form-group grid-2-col">
                        <div>
                            <label class="form-label">Category</label>
                            <select id="stk-form-category" class="form-select">
                                <option value="TOUR_GUIDE">Tour Guide</option>
                                <option value="TRANSPORT_DRIVER">Transport &amp; Habal-Habal Driver</option>
                                <option value="BOAT_OPERATOR">Motorized Boat Operator</option>
                                <option value="LOCAL_COOK">Local Cook &amp; Caterer</option>
                                <option value="ARTISAN">Handicraft &amp; Pottery Artisan</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Barangay</label>
                            <select id="stk-form-barangay" class="form-select" required></select>
                        </div>
                    </div>
                    <div class="form-group grid-2-col">
                        <div>
                            <label class="form-label">Accreditation / Permit No.</label>
                            <input type="text" id="stk-form-accred" class="form-input" placeholder="e.g. BIL-TG-2025-001">
                        </div>
                        <div>
                            <label class="form-label">Years of Experience</label>
                            <input type="number" id="stk-form-exp" class="form-input" min="0" max="60" value="3">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Contact Phone</label>
                        <input type="text" id="stk-form-phone" class="form-input" placeholder="e.g. 0917-555-0199">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Bio / Specializations</label>
                        <textarea id="stk-form-bio" class="form-textarea" rows="3" placeholder="Describe guiding certifications, vessel capacity, or specialty crafts..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Save Stakeholder Profile</button>
                </form>
            </div>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- EDIT BARANGAY RECORD MODAL                                              -->
    <!-- ======================================================================= -->
    <div class="modal-backdrop" id="modal-edit-barangay">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 class="modal-title"><i class="fa-solid fa-map-location"></i> Update Barangay Tourism Record</h3>
                <button class="btn-close" onclick="closeModal('modal-edit-barangay')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="form-edit-barangay" onsubmit="handleUpdateBarangaySubmit(event)">
                    <input type="hidden" id="brgy-edit-id">
                    <div class="form-group">
                        <label class="form-label">Barangay</label>
                        <input type="text" id="brgy-edit-name" class="form-input" readonly>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tourism Focal Person / Barangay Captain</label>
                        <input type="text" id="brgy-edit-contact-person" class="form-input" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Official Contact Phone</label>
                        <input type="text" id="brgy-edit-contact-number" class="form-input" required>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Save Barangay Record</button>
                </form>
            </div>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- ADMIN EDIT USER MODAL & RESET PASSWORD MODAL                            -->
    <!-- ======================================================================= -->
    <div class="modal-backdrop" id="modal-edit-user">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 class="modal-title"><i class="fa-solid fa-user-pen"></i> Edit User Account</h3>
                <button class="btn-close" onclick="closeModal('modal-edit-user')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="form-edit-user" onsubmit="handleEditUserSubmit(event)">
                    <input type="hidden" id="edit-user-id">
                    <div class="form-group">
                        <label class="form-label">Username</label>
                        <input type="text" id="edit-user-username" class="form-input" readonly>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Full Name</label>
                        <input type="text" id="edit-user-fullname" class="form-input" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <input type="email" id="edit-user-email" class="form-input" required>
                    </div>
                    <div class="form-group grid-2-col">
                        <div>
                            <label class="form-label">Assigned Role</label>
                            <select id="edit-user-role" class="form-select" required>
                                <option value="6">Tourist</option>
                                <option value="5">Community Worker</option>
                                <option value="4">Barangay Official</option>
                                <option value="3">Municipal Tourism Officer</option>
                                <option value="2">Tourism Office</option>
                                <option value="1">System Administrator</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Jurisdiction Barangay</label>
                            <select id="edit-user-barangay" class="form-select">
                                <option value="">None (Province-wide)</option>
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Update User Account</button>
                </form>
            </div>
        </div>
    </div>

    <div class="modal-backdrop" id="modal-reset-password">
        <div class="modal-dialog">
            <div class="modal-header">
                <h3 class="modal-title"><i class="fa-solid fa-key"></i> Admin Reset User Password</h3>
                <button class="btn-close" onclick="closeModal('modal-reset-password')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="form-admin-reset-password" onsubmit="handleAdminResetPasswordSubmit(event)">
                    <input type="hidden" id="reset-pwd-user-id">
                    <div class="form-group">
                        <label class="form-label">Target Account</label>
                        <input type="text" id="reset-pwd-username" class="form-input" readonly>
                    </div>
                    <div class="form-group">
                        <label class="form-label">New Password</label>
                        <input type="password" id="reset-pwd-new" class="form-input" minlength="6" required placeholder="Enter new password (min. 6 chars)">
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Reset Password</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="toast-stack"></div>

    <!-- Scripts -->
    <script src="js/app.js"></script>
</body>
</html>
