/* ==============================================================================
   LAKBAY LOKAL: COMMUNITY TOURISM INFORMATION SYSTEM
   PREMIUM DESIGN SYSTEM & STYLESHEET
   Locale: Biliran, Philippines
============================================================================== */

:root {
    /* Primary Color Palette - Philippine Nature & Ocean */
    --primary-950: #042f2e;
    --primary-900: #064e3b;
    --primary-800: #065f46;
    --primary-700: #047857;
    --primary-600: #059669;
    --primary-500: #10b981;
    --primary-400: #34d399;
    --primary-300: #6ee7b7;
    --primary-200: #a7f3d0;
    --primary-100: #d1fae5;
    --primary-50:  #ecfdf5;

    /* Secondary / Accent Palette - Amber Sunset & Coastal Cyan */
    --accent-700: #b45309;
    --accent-600: #d97706;
    --accent-500: #f59e0b;
    --accent-400: #fbbf24;
    --accent-200: #fde68a;
    --accent-100: #fef3c7;
    --accent-50:  #fffbeb;
    --cyan-700:   #0e7490;
    --cyan-600:   #0891b2;
    --cyan-500:   #06b6d4;
    --cyan-100:   #cffafe;
    --cyan-50:    #ecfeff;

    /* Neutrals & Slate Base */
    --slate-900: #0f172a;
    --slate-800: #1e293b;
    --slate-700: #334155;
    --slate-600: #475569;
    --slate-500: #64748b;
    --slate-400: #94a3b8;
    --slate-300: #cbd5e1;
    --slate-200: #e2e8f0;
    --slate-100: #f1f5f9;
    --slate-50:  #f8fafc;
    --white:     #ffffff;

    /* Status Colors */
    --status-success: #10b981;
    --status-warning: #f59e0b;
    --status-danger:  #ef4444;
    --status-info:    #3b82f6;

    /* Shadows & Elevations */
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.05);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.04);
    --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.06);

    /* Dimensions & Transitions */
    --header-height: 72px;
    --sidebar-width: 270px;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --transition-fast: 0.15s ease;
    --transition-base: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

/* -------------------------------------------------------------------------- */
/* RESET & TYPOGRAPHY                                                         */
/* -------------------------------------------------------------------------- */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background-color: #f3f6f9;
    color: var(--slate-800);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
    font-weight: 700;
    color: var(--slate-900);
    line-height: 1.25;
}

a {
    color: var(--primary-700);
    text-decoration: none;
    transition: color var(--transition-fast);
}

/* -------------------------------------------------------------------------- */
/* LAYOUT STRUCTURE                                                           */
/* -------------------------------------------------------------------------- */
.app-layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* Top Navbar */
.top-navbar {
    height: var(--header-height);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--slate-200);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.75rem;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: var(--shadow-sm);
}

.nav-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
}

.brand-logo {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--primary-800), var(--primary-600));
    color: var(--white);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    box-shadow: 0 4px 10px rgba(5, 150, 105, 0.3);
}

.brand-text h1.brand-title {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--primary-900);
}

.brand-subtitle {
    font-size: 0.75rem;
    color: var(--slate-500);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

/* Role Switcher Pill */
.role-switcher-container {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--slate-100);
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--slate-300);
}

.switcher-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--slate-700);
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

.role-select-input {
    background: var(--white);
    border: 1px solid var(--slate-300);
    color: var(--primary-800);
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    cursor: pointer;
    outline: none;
    transition: var(--transition-fast);
}

.role-select-input:focus {
    border-color: var(--primary-600);
    box-shadow: 0 0 0 2px var(--primary-100);
}

/* User Account Section in Navbar */
.nav-user-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.auth-buttons {
    display: flex;
    gap: 0.5rem;
}

.logged-user-profile {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--slate-200);
}

.user-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--primary-100);
    color: var(--primary-800);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
}

.user-meta {
    display: flex;
    flex-direction: column;
}

.user-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--slate-900);
}

.user-role-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: var(--primary-100);
    color: var(--primary-800);
    letter-spacing: 0.03em;
    width: fit-content;
}

/* App Body (Sidebar + Viewport) */
.app-body {
    display: flex;
    flex: 1;
}

/* Sidebar */
.sidebar {
    width: var(--sidebar-width);
    background: var(--white);
    border-right: 1px solid var(--slate-200);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100vh - var(--header-height));
    position: sticky;
    top: var(--header-height);
    overflow-y: auto;
    padding: 1.25rem 0.85rem;
}

.nav-menu {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.nav-item .nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    color: var(--slate-600);
    font-weight: 600;
    font-size: 0.88rem;
    transition: all var(--transition-fast);
}

.nav-item .nav-link:hover {
    background: var(--slate-100);
    color: var(--primary-800);
}

.nav-item .nav-link.active {
    background: linear-gradient(135deg, var(--primary-700), var(--primary-800));
    color: var(--white);
    box-shadow: 0 4px 10px rgba(6, 95, 70, 0.25);
}

.nav-icon {
    font-size: 1.05rem;
    width: 20px;
    text-align: center;
}

.nav-counter-badge {
    margin-left: auto;
    background: var(--accent-500);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
}

.sidebar-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--slate-200);
}

.connection-status-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--slate-100);
    color: var(--slate-600);
}

.connection-status-pill.online {
    background: var(--primary-50);
    color: var(--primary-800);
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status-success);
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
}

/* Main Viewport */
.main-content {
    flex: 1;
    width: 100%;
    min-width: 0;
    padding: 1.75rem 2.25rem;
    overflow-y: auto;
    max-width: 1440px;
    margin: 0 auto;
}

/* Notice Bar */
.notice-bar {
    background: linear-gradient(90deg, #ecfdf5, #fef3c7);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-md);
    padding: 0.65rem 1rem;
    font-size: 0.85rem;
    color: var(--primary-900);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
}

.notice-icon {
    color: var(--accent-600);
    font-size: 1rem;
}

/* Page Header */
.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
}

.page-title {
    font-size: 1.5rem;
    color: var(--slate-900);
    letter-spacing: -0.02em;
}

.page-desc {
    font-size: 0.88rem;
    color: var(--slate-500);
    margin-top: 0.2rem;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
}

/* Tab Panes */
.tab-pane {
    display: none;
    animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-pane.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}

/* -------------------------------------------------------------------------- */
/* BUTTONS & CONTROLS                                                         */
/* -------------------------------------------------------------------------- */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.85rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.btn-primary {
    background: var(--primary-700);
    color: var(--white);
    box-shadow: 0 2px 4px rgba(4, 120, 87, 0.2);
}

.btn-primary:hover {
    background: var(--primary-800);
    box-shadow: 0 4px 8px rgba(4, 120, 87, 0.3);
}

.btn-secondary {
    background: var(--slate-800);
    color: var(--white);
}

.btn-secondary:hover {
    background: var(--slate-900);
}

.btn-outline {
    background: var(--white);
    border-color: var(--slate-300);
    color: var(--slate-700);
}

.btn-outline:hover {
    background: var(--slate-100);
    color: var(--slate-900);
}

.btn-link {
    background: none;
    border: none;
    color: var(--primary-700);
    font-weight: 600;
    cursor: pointer;
    padding: 0;
}

.btn-link:hover {
    text-decoration: underline;
}

.btn-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--slate-200);
    background: var(--white);
    color: var(--slate-600);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-fast);
}

.btn-icon:hover {
    background: var(--slate-100);
    color: var(--slate-900);
}

.btn-block {
    width: 100%;
}

.btn-sm {
    padding: 0.3rem 0.65rem;
    font-size: 0.78rem;
}

.btn-success {
    background: var(--status-success);
    color: var(--white);
}

.btn-danger {
    background: var(--status-danger);
    color: var(--white);
}

/* Form Inputs */
.form-group {
    margin-bottom: 1rem;
}

.form-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--slate-700);
    margin-bottom: 0.35rem;
}

.form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--slate-300);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 0.85rem;
    color: var(--slate-800);
    background: var(--white);
    outline: none;
    transition: border-color var(--transition-fast);
}

.form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: var(--primary-600);
    box-shadow: 0 0 0 3px var(--primary-100);
}

.form-textarea {
    resize: vertical;
    min-height: 80px;
}

/* -------------------------------------------------------------------------- */
/* CARDS & CONTAINERS                                                         */
/* -------------------------------------------------------------------------- */
.card {
    background: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--slate-200);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
}

.card-header {
    padding: 1rem 1.35rem;
    border-bottom: 1px solid var(--slate-200);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-title {
    font-size: 1.05rem;
    color: var(--slate-800);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.card-body {
    padding: 1.35rem;
}

/* Grid Layouts */
.grid-2-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
}

.grid-3-col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
}

.card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
}

/* KPI Grid */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.75rem;
}

.kpi-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--slate-200);
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
}

.kpi-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
}

.kpi-icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

.kpi-icon-wrapper.emerald {
    background: var(--primary-100);
    color: var(--primary-800);
}

.kpi-icon-wrapper.teal {
    background: #ccfbf1;
    color: #0f766e;
}

.kpi-icon-wrapper.amber {
    background: var(--accent-100);
    color: var(--accent-600);
}

.kpi-icon-wrapper.blue {
    background: #dbeafe;
    color: #1d4ed8;
}

.kpi-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--slate-500);
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.kpi-value {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--slate-900);
    line-height: 1.1;
    margin: 0.2rem 0;
}

.kpi-subtext {
    font-size: 0.72rem;
    color: var(--slate-500);
}

/* Hero Showcase Card */
.hero-showcase-card {
    position: relative;
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, #032219 0%, #064e3b 50%, #0d9488 100%);
    min-height: 250px;
    padding: 2.25rem;
    display: flex;
    align-items: flex-end;
    margin-bottom: 1.75rem;
    overflow: hidden;
    box-shadow: var(--shadow-md);
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 78, 59, 0.2) 0%, rgba(15, 23, 42, 0.88) 100%);
}

.hero-content {
    position: relative;
    z-index: 2;
    color: var(--white);
    max-width: 650px;
}

.hero-tag {
    background: rgba(16, 185, 129, 0.35);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-block;
    margin-bottom: 0.5rem;
}

.hero-heading {
    font-size: 1.75rem;
    color: var(--white);
    margin-bottom: 0.5rem;
}

.hero-caption {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
    margin-bottom: 1rem;
}

.hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
}

.hero-badges span {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    backdrop-filter: blur(4px);
}

.overview-dual-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 1.5rem;
}

/* -------------------------------------------------------------------------- */
/* DESTINATION & PACKAGE CARDS                                                */
/* -------------------------------------------------------------------------- */
.item-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--slate-200);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
}

.item-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.item-card-image {
    height: 180px;
    position: relative;
    background: var(--slate-800);
}

.item-card-image.no-photo {
    height: 110px;
    background: linear-gradient(135deg, #047857 0%, #064e3b 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.item-card-image.no-photo .dest-icon {
    font-size: 2.5rem;
    color: rgba(255, 255, 255, 0.88);
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
}

.item-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.item-card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(6px);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    text-transform: uppercase;
}

.item-card-rating {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--accent-600);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 0.25rem;
}

.item-card-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
}

.item-card-title {
    font-size: 1.1rem;
    color: var(--slate-900);
    margin-bottom: 0.35rem;
}

.item-card-location {
    font-size: 0.8rem;
    color: var(--slate-500);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
}

.item-card-desc {
    font-size: 0.84rem;
    color: var(--slate-600);
    line-height: 1.45;
    margin-bottom: 1rem;
    flex: 1;
}

.item-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px solid var(--slate-100);
}

.item-price-tag {
    display: flex;
    flex-direction: column;
}

.item-price-label {
    font-size: 0.7rem;
    color: var(--slate-400);
    text-transform: uppercase;
    font-weight: 600;
}

.item-price-val {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--primary-800);
}

.card-mgmt-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--slate-200);
}

.card-mgmt-actions .btn {
    flex: 1;
}

.table-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
}

/* Filter Toolbar */
.filter-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
}

.search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    border: 1px solid var(--slate-300);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-md);
    flex: 1;
    min-width: 250px;
}

.search-box input {
    border: none;
    outline: none;
    width: 100%;
    font-size: 0.85rem;
    font-family: inherit;
}

.filter-controls {
    display: flex;
    gap: 0.65rem;
}

/* -------------------------------------------------------------------------- */
/* SUB-TABS & BUILDER                                                         */
/* -------------------------------------------------------------------------- */
.sub-nav-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--slate-200);
    padding-bottom: 0.5rem;
}

.sub-tab {
    background: none;
    border: none;
    padding: 0.55rem 1rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--slate-600);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: var(--transition-fast);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.sub-tab:hover {
    background: var(--slate-100);
    color: var(--primary-800);
}

.sub-tab.active {
    background: var(--primary-100);
    color: var(--primary-800);
    font-weight: 700;
}

.builder-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.75rem;
}

.service-checkbox-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.service-select-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-md);
    background: var(--white);
    transition: var(--transition-fast);
}

.service-select-item:hover {
    border-color: var(--primary-500);
    background: var(--primary-50);
}

.service-item-info {
    display: flex;
    flex-direction: column;
}

.service-item-title {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--slate-800);
}

.service-item-sub {
    font-size: 0.78rem;
    color: var(--slate-500);
}

.service-item-rate {
    font-weight: 800;
    color: var(--primary-700);
    font-size: 0.95rem;
    margin-right: 1rem;
}

.sticky-card {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
}

.summary-breakdown {
    min-height: 120px;
    font-size: 0.85rem;
}

.summary-item-row {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0;
    border-bottom: 1px dashed var(--slate-200);
}

.summary-total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.1rem;
    font-weight: 700;
}

.summary-total-row .total-price {
    font-size: 1.45rem;
    color: var(--primary-800);
    font-weight: 800;
}

.summary-pax-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    margin-top: 0.35rem;
}

/* -------------------------------------------------------------------------- */
/* DATA TABLES                                                                */
/* -------------------------------------------------------------------------- */
.table-responsive {
    overflow-x: auto;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.85rem;
}

.data-table th {
    background: var(--slate-50);
    color: var(--slate-600);
    font-weight: 700;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--slate-200);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
}

.data-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--slate-100);
    color: var(--slate-800);
    vertical-align: middle;
}

.data-table tbody tr:hover {
    background: var(--slate-50);
}

/* Badges */
.badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    text-transform: uppercase;
}

.badge-success {
    background: #d1fae5;
    color: #065f46;
}

.badge-warning {
    background: #fef3c7;
    color: #92400e;
}

.badge-danger {
    background: #fee2e2;
    color: #991b1b;
}

.badge-info {
    background: #e0f2fe;
    color: #0369a1;
}

/* Star Rating */
.star-rating-selector {
    display: flex;
    gap: 0.35rem;
    font-size: 1.5rem;
    color: var(--slate-300);
    cursor: pointer;
    margin: 0.5rem 0;
}

.star-rating-selector .star.active {
    color: #f59e0b;
}

/* -------------------------------------------------------------------------- */
/* MODALS                                                                     */
/* -------------------------------------------------------------------------- */
.modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}

.modal-backdrop.open {
    display: flex;
    animation: fadeIn 0.2s ease;
}

.modal-dialog {
    background: var(--white);
    border-radius: var(--radius-xl);
    width: 100%;
    max-width: 540px;
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
}

.modal-header {
    padding: 1.15rem 1.5rem;
    border-bottom: 1px solid var(--slate-200);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.modal-title {
    font-size: 1.15rem;
    color: var(--slate-900);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    color: var(--slate-400);
    cursor: pointer;
}

.btn-close:hover {
    color: var(--slate-800);
}

.modal-body {
    padding: 1.5rem;
    overflow-y: auto;
}

/* Demo Accounts Quick Login Buttons */
.demo-accounts-box {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--slate-200);
}

.demo-title {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--slate-500);
    margin-bottom: 0.65rem;
}

.demo-btn-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
}

.btn-demo {
    background: var(--slate-100);
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--slate-700);
    cursor: pointer;
    text-align: left;
    transition: var(--transition-fast);
}

.btn-demo:hover {
    background: var(--primary-100);
    color: var(--primary-800);
    border-color: var(--primary-500);
}

/* Toast Notifications */
.toast-stack {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 200;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.toast {
    background: var(--slate-900);
    color: var(--white);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    font-size: 0.85rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    animation: slideInRight 0.25s ease;
}

.toast.success { background: #065f46; }
.toast.error { background: #991b1b; }
.toast.info { background: #1e293b; }

@keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

/* Helper Utilities */
.text-muted { color: var(--slate-500); }
.text-center { text-align: center; }
.font-bold { font-weight: 700; }
.mb-3 { margin-bottom: 0.75rem; }
.mb-4 { margin-bottom: 1.5rem; }
.mt-4 { margin-top: 1rem; }
.my-3 { margin-top: 0.75rem; margin-bottom: 0.75rem; }
.py-4 { padding-top: 1rem; padding-bottom: 1rem; }
.divider { border: 0; border-top: 1px solid var(--slate-200); margin: 0.85rem 0; }

/* ==============================================================================
   DESKTOP TITLEBAR (ELECTRON WINDOW CONTROLS)
   ============================================================================== */
.desktop-titlebar {
    height: 38px;
    background: #021a13;
    color: #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    user-select: none;
    -webkit-app-region: drag;
    z-index: 9999;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.desktop-titlebar-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.desktop-titlebar-icon {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    object-fit: cover;
}

.desktop-titlebar-controls {
    display: flex;
    align-items: center;
    -webkit-app-region: no-drag;
}

.titlebar-btn {
    background: none;
    border: none;
    color: #94a3b8;
    width: 40px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    font-size: 0.75rem;
}

.titlebar-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

.titlebar-btn.close:hover {
    background: #dc2626;
    color: #ffffff;
}

/* ==============================================================================
   PUBLIC HOMEPAGE STYLES
   ============================================================================== */
.portal-view {
    display: none;
}

.portal-view.active {
    display: block;
}

.public-portal-wrapper {
    background: #fdfefe;
    color: var(--slate-800);
}

/* Public Navbar */
.public-navbar {
    position: sticky;
    top: 0;
    height: 76px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.85);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 3.5rem;
    z-index: 100;
    box-shadow: 0 4px 20px -2px rgba(6, 78, 59, 0.05);
}

.public-nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
}

.public-nav-link {
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--slate-700);
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.public-nav-link:hover {
    color: var(--primary-600);
}

.public-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
}

/* Public Hero Section */
.public-hero-section {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4.5rem 2rem;
    background: linear-gradient(135deg, #032219 0%, #064e3b 50%, #0d9488 100%);
    color: var(--white);
    overflow: hidden;
}

.public-hero-content {
    max-width: 980px;
    text-align: center;
    position: relative;
    z-index: 2;
}

.hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.1rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #6ee7b7;
    margin-bottom: 1.5rem;
}

.public-hero-title {
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1.18;
    color: #ffffff;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.public-hero-subtitle {
    font-size: 1.18rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 2.25rem;
    max-width: 840px;
    margin-left: auto;
    margin-right: auto;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
}

/* Hero Live Search & Filter Bar */
.hero-search-wrapper {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-xl);
    padding: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 860px;
    margin: 0 auto 2.5rem;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.35);
}

.hero-search-input-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 2;
    padding: 0 1rem;
    color: var(--slate-600);
}

.hero-search-input-box input {
    border: none;
    background: transparent;
    width: 100%;
    font-size: 0.95rem;
    color: var(--slate-900);
    outline: none;
    font-family: inherit;
}

.hero-search-divider {
    width: 1px;
    height: 32px;
    background: var(--slate-200);
}

.hero-search-select {
    flex: 1.2;
    border: none;
    background: transparent;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--slate-700);
    outline: none;
    cursor: pointer;
    font-family: inherit;
}

.hero-btn-search {
    background: linear-gradient(135deg, var(--primary-600), var(--primary-700));
    color: #ffffff;
    border: none;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-lg);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 14px rgba(5, 150, 105, 0.4);
}

.hero-btn-search:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(5, 150, 105, 0.5);
}

/* Fast Stats Bar in Hero */
.hero-stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    max-width: 860px;
    margin: 0 auto;
}

.hero-stat-card {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
    text-align: center;
    transition: transform 0.2s;
}

.hero-stat-card:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.16);
}

.hero-stat-num {
    font-size: 1.65rem;
    font-weight: 800;
    color: #ffffff;
    display: block;
    line-height: 1.1;
    margin-bottom: 0.25rem;
}

.hero-stat-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #d1fae5;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

/* Public Sections Common */
.public-section {
    padding: 5rem 3.5rem;
}

.public-section.bg-light {
    background: #f8fafc;
}

.section-header-center {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem;
}

.section-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-600);
    background: var(--primary-50);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
    border: 1px solid var(--primary-100);
}

.section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--slate-900);
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
}

.section-subtitle {
    font-size: 1.05rem;
    color: var(--slate-600);
    line-height: 1.6;
}

/* Category Filter Pills */
.category-filter-pills {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 2.5rem;
}

.cat-pill {
    padding: 0.5rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--slate-200);
    background: var(--white);
    color: var(--slate-700);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
}

.cat-pill:hover {
    border-color: var(--primary-500);
    color: var(--primary-700);
    background: var(--primary-50);
}

.cat-pill.active {
    background: var(--primary-700);
    color: #ffffff;
    border-color: var(--primary-700);
    box-shadow: 0 4px 12px rgba(4, 120, 87, 0.25);
}

/* Public Destination Cards */
.public-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
}

.public-dest-card {
    background: var(--white);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.06);
    border: 1px solid var(--slate-200);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
}

.public-dest-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px -4px rgba(6, 78, 59, 0.12);
    border-color: var(--primary-200);
}

.public-dest-thumb {
    position: relative;
    height: 220px;
    background: #0f172a;
    overflow: hidden;
}

.public-dest-thumb.no-photo {
    height: 120px;
    background: linear-gradient(135deg, #047857 0%, #064e3b 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.public-dest-thumb.no-photo .dest-icon {
    font-size: 2.75rem;
    color: rgba(255, 255, 255, 0.88);
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
}

.public-dest-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.public-dest-card:hover .public-dest-thumb img {
    transform: scale(1.05);
}

.public-dest-cat-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(3, 34, 25, 0.85);
    backdrop-filter: blur(8px);
    color: #6ee7b7;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.public-dest-fee-tag {
    position: absolute;
    bottom: 14px;
    right: 14px;
    background: rgba(255, 255, 255, 0.95);
    color: var(--slate-900);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    box-shadow: var(--shadow-md);
}

.public-dest-body {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.public-dest-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--slate-900);
    margin-bottom: 0.4rem;
}

.public-dest-location {
    font-size: 0.85rem;
    color: var(--slate-500);
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.public-dest-desc {
    font-size: 0.9rem;
    color: var(--slate-600);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex: 1;
}

.public-dest-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--slate-100);
}

/* Community Stakeholder Highlights */
.community-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.75rem;
}

.community-worker-card {
    background: var(--white);
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, box-shadow 0.2s;
}

.community-worker-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary-300);
}

.worker-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--primary-50);
    color: var(--primary-700);
    font-size: 1.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    border: 2px solid var(--primary-200);
}

.worker-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--slate-900);
    margin-bottom: 0.25rem;
}

.worker-role {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--primary-600);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
}

.worker-desc {
    font-size: 0.85rem;
    color: var(--slate-600);
    line-height: 1.5;
    margin-bottom: 1rem;
}

/* About Biliran Grid */
.about-dual-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3.5rem;
    align-items: center;
}

.about-features-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
}

.about-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
}

.about-feature-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--primary-50);
    color: var(--primary-700);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
    border: 1px solid var(--primary-100);
}

.about-feature-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--slate-900);
    margin-bottom: 0.2rem;
}

.about-feature-desc {
    font-size: 0.88rem;
    color: var(--slate-600);
    line-height: 1.5;
}

.about-visual-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.2);
}

.about-visual-card img {
    width: 100%;
    height: 460px;
    object-fit: cover;
    display: block;
}

.about-visual-badge {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(3, 34, 25, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    color: #ffffff;
}

/* Public Footer */
.public-footer {
    background: #021a13;
    color: #e2e8f0;
    padding: 4.5rem 3.5rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.footer-top-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
}

.footer-brand-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
}

.footer-brand-desc {
    font-size: 0.88rem;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 1.5rem;
}

.footer-col-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
}

.footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
}

.footer-link {
    color: #94a3b8;
    font-size: 0.88rem;
    transition: color 0.2s;
}

.footer-link:hover {
    color: #6ee7b7;
}

.footer-bottom-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.82rem;
    color: #64748b;
}

/* ==============================================================================
   TRUE GLASSMORPHISM LOGIN PORTAL
   ============================================================================== */
.glass-portal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 2000;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: radial-gradient(circle at center, rgba(6, 78, 59, 0.88) 0%, rgba(2, 26, 19, 0.97) 100%);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    animation: glassPortalFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.glass-portal-backdrop.open {
    display: flex;
}

.glass-portal-card {
    display: flex;
    width: 100%;
    max-width: 980px;
    min-height: 600px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 28px;
    box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.55), 0 0 50px rgba(16, 185, 129, 0.18);
    overflow: hidden;
    position: relative;
    animation: glassPortalSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.glass-btn-close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    cursor: pointer;
    z-index: 20;
    transition: background 0.2s, transform 0.2s;
}

.glass-btn-close:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: rotate(90deg);
}

/* Left Panel */
.glass-left-panel {
    flex: 1.1;
    position: relative;
    padding: 3rem 2.5rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(135deg, rgba(3, 34, 25, 0.95) 0%, rgba(6, 78, 59, 0.88) 100%);
    border-right: 1px solid rgba(255, 255, 255, 0.15);
}

.glass-left-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
}

.glass-brand-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    color: #6ee7b7;
}

.glass-brand-name {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #ffffff;
    line-height: 1.1;
}

.glass-brand-tagline {
    font-size: 0.78rem;
    color: #a7f3d0;
    font-weight: 500;
}

.glass-left-body {
    margin: 2.5rem 0;
}

.glass-welcome-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 0.85rem;
    color: #ffffff;
}

.glass-welcome-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1.5rem;
}

.glass-community-pledge-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 16px;
    padding: 1.15rem;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
}

.pledge-icon {
    font-size: 1.35rem;
    color: #6ee7b7;
    margin-top: 0.15rem;
}

.pledge-text {
    font-size: 0.84rem;
    line-height: 1.5;
    color: #e2e8f0;
}

.glass-left-footer {
    font-size: 0.75rem;
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

/* Right Panel */
.glass-right-panel {
    flex: 1.2;
    padding: 3rem 2.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgba(15, 23, 42, 0.35);
}

.glass-form-header {
    margin-bottom: 1.75rem;
}

.glass-form-heading {
    font-size: 1.75rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.35rem;
}

.glass-form-subtext {
    font-size: 0.88rem;
    color: #94a3b8;
}

.glass-field-group {
    margin-bottom: 1.25rem;
}

.glass-field-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 0.45rem;
}

.glass-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.glass-input-icon {
    position: absolute;
    left: 14px;
    color: #94a3b8;
    font-size: 0.95rem;
    pointer-events: none;
}

.glass-input {
    width: 100%;
    height: 48px;
    padding: 0 1rem 0 2.75rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    color: #ffffff;
    font-size: 0.92rem;
    outline: none;
    font-family: inherit;
    transition: all 0.2s ease;
}

.glass-input:focus {
    background: rgba(255, 255, 255, 0.12);
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
}

.glass-input::placeholder {
    color: #64748b;
}

.glass-btn-toggle-pwd {
    position: absolute;
    right: 12px;
    background: none;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    font-size: 0.95rem;
    padding: 0.4rem;
    transition: color 0.2s;
}

.glass-btn-toggle-pwd:hover {
    color: #ffffff;
}

.glass-form-options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    font-size: 0.84rem;
}

.glass-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #cbd5e1;
    cursor: pointer;
    user-select: none;
}

.glass-checkbox-label input[type="checkbox"] {
    accent-color: #10b981;
    width: 15px;
    height: 15px;
    cursor: pointer;
}

.glass-forgot-link {
    color: #6ee7b7;
    font-weight: 600;
    transition: color 0.2s;
    background: none;
    border: none;
    cursor: pointer;
    font-size: inherit;
    font-family: inherit;
    padding: 0;
}

.glass-forgot-link:hover {
    color: #a7f3d0;
    text-decoration: underline;
}

.glass-btn-submit {
    width: 100%;
    height: 50px;
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    box-shadow: 0 4px 15px rgba(5, 150, 105, 0.4);
    transition: all 0.2s ease;
}

.glass-btn-submit:hover {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
}

.glass-btn-submit:active {
    transform: translateY(0);
}

.glass-error-banner {
    display: none;
    background: rgba(239, 68, 68, 0.18);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 10px;
    padding: 0.65rem 0.85rem;
    color: #fca5a5;
    font-size: 0.82rem;
    margin-bottom: 1rem;
    align-items: center;
    gap: 0.5rem;
}

.glass-error-banner.show {
    display: flex;
}

.glass-demo-section {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.glass-demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
}

.glass-demo-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
}

.glass-demo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
}

.glass-btn-demo {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0.45rem 0.55rem;
    color: #e2e8f0;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
}

.glass-btn-demo:hover {
    background: rgba(16, 185, 129, 0.2);
    border-color: rgba(16, 185, 129, 0.5);
    color: #ffffff;
    transform: translateY(-1px);
}

.demo-role-name {
    font-weight: 700;
    color: #6ee7b7;
}

.demo-role-user {
    font-size: 0.66rem;
    color: #94a3b8;
}

/* ==============================================================================
   PORTAL VIEWS & ROLE WORKSPACE STYLES
   ============================================================================== */
.portal-view {
    display: none;
    width: 100%;
    min-height: 100vh;
}

.portal-view.active {
    display: block;
}

#login-portal-view.active {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2.5rem 1.5rem;
    background: radial-gradient(circle at 50% 20%, rgba(6, 78, 59, 0.95) 0%, rgba(2, 26, 19, 0.98) 100%);
}

.glass-features-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 1.25rem;
}

.glass-feat-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: #a7f3d0;
    font-weight: 500;
}

.glass-feat-item i {
    color: #34d399;
}

.glass-register-prompt {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: #94a3b8;
}

.glass-link-btn {
    background: none;
    border: none;
    color: #6ee7b7;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    font-size: 0.85rem;
    font-family: inherit;
    padding: 0;
}

.glass-link-btn:hover {
    color: #a7f3d0;
}

/* Pre-seeded Test Accounts Reference Accordion */
.glass-accounts-reference {
    margin-top: 1.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    color: #cbd5e1;
    font-size: 0.8rem;
}

.glass-accounts-reference summary {
    cursor: pointer;
    font-weight: 600;
    color: #e2e8f0;
    user-select: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.glass-accounts-reference summary:hover {
    color: #6ee7b7;
}

.glass-accounts-ref-body {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.ref-subtext {
    font-size: 0.75rem;
    color: #94a3b8;
    margin-bottom: 0.65rem;
}

.ref-subtext code {
    background: rgba(0, 0, 0, 0.3);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: #6ee7b7;
}

.ref-accounts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
}

.ref-account-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0.45rem 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    cursor: pointer;
    transition: all 0.2s ease;
}

.ref-account-card:hover {
    background: rgba(16, 185, 129, 0.18);
    border-color: rgba(16, 185, 129, 0.5);
    transform: translateY(-2px);
}

.ref-role-tag {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.ref-role-tag.tourist { color: #38bdf8; }
.ref-role-tag.stakeholder { color: #f59e0b; }
.ref-role-tag.barangay { color: #10b981; }
.ref-role-tag.lgu { color: #a855f7; }
.ref-role-tag.tourism { color: #ec4899; }
.ref-role-tag.admin { color: #f43f5e; }

.ref-account-user {
    font-size: 0.78rem;
    font-weight: 600;
    color: #f1f5f9;
    font-family: monospace;
}

/* Role Workspace Banner inside Management Portal */
.role-workspace-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: linear-gradient(135deg, #064e3b 0%, #022c22 100%);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.75rem;
    margin-bottom: 1.75rem;
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(6, 78, 59, 0.15);
}

.role-banner-content {
    flex: 1;
}

.role-banner-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(16, 185, 129, 0.2);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.35rem;
}

.role-banner-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.25rem 0;
    letter-spacing: -0.01em;
}

.role-banner-desc {
    margin: 0;
    color: #a7f3d0;
    font-size: 0.88rem;
    line-height: 1.45;
}

.role-banner-scope-pill {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #e2e8f0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
}

/* Animations */
@keyframes glassPortalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes glassPortalSlideUp {
    from { opacity: 0; transform: scale(0.96) translateY(14px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
}

/* Responsive adjustments */
@media (max-width: 900px) {
    .public-navbar { padding: 0 1.5rem; }
    .public-nav-links { display: none; }
    .public-hero-title { font-size: 2.25rem; }
    .hero-stats-row { grid-template-columns: repeat(2, 1fr); }
    .hero-search-wrapper { flex-direction: column; }
    .hero-search-divider { display: none; }
    .hero-btn-search { width: 100%; justify-content: center; }
    .about-dual-grid { grid-template-columns: 1fr; }
    .footer-top-grid { grid-template-columns: 1fr; gap: 2rem; }
    .glass-portal-card { flex-direction: column; max-height: 90vh; overflow-y: auto; }
    .glass-left-panel { border-right: none; border-bottom: 1px solid rgba(255, 255, 255, 0.15); padding: 2rem; }
    .glass-right-panel { padding: 2rem; }
    .glass-demo-grid { grid-template-columns: repeat(2, 1fr); }
    .ref-accounts-grid { grid-template-columns: repeat(2, 1fr); }
    .role-workspace-banner { flex-direction: column; align-items: flex-start; gap: 1rem; }
}
