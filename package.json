{
  "name": "lakbay-lokal",
  "version": "1.0.0",
  "description": "Lakbay Lokal: A Community-Based Tourism Information System for Biliran, Philippines",
  "main": "electron/main.js",
  "author": "Lakbay Lokal Development Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "ph.gov.biliran.lakbaylokal",
    "productName": "Lakbay Lokal",
    "copyright": "Copyright © 2026 Lakbay Lokal Tourism Network",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/main/resources/web/**/*",
      "bin/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lakbay Lokal Biliran"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
